<IfModule mod_rewrite.c>
	RewriteEngine On

	# RSS feed aliases.
	# /rss.xml is the machine-readable feed; /rss.xml/ is a human-friendly page.
	#
	# IMPORTANT: avoid relative redirect targets (like "rss.xml") here.
	# In .htaccess context, relative substitutions can be prefixed by a filesystem path
	# when RewriteBase is not set, producing malformed Location headers.
	# Instead, build a root-relative target from the request URI prefix.

	# Friendly browser page for people who accidentally add the trailing slash.
	RewriteCond %{REQUEST_URI} ^(.*/)rss\.xml/$ [NC]
	RewriteRule ^ %1rss-reader/ [QSA,L]

	# Common guesses: /rss and /feed (with or without a trailing slash).
	RewriteCond %{REQUEST_URI} ^(.*/)(rss|feed)/?$ [NC]
	RewriteRule ^ %1rss.xml [R=301,L]

</IfModule>

# Serve the prerendered RSS file with an RSS-specific content type.
# (Many readers accept application/xml, but some expect application/rss+xml.)
<Files "rss.xml">
	ForceType application/rss+xml
</Files>

<IfModule mod_headers.c>
	Header always set Strict-Transport-Security "max-age=31536000"
	Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; upgrade-insecure-requests"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set X-Content-Type-Options "nosniff"

	<Files "rss.xml">
		Header set Content-Type "application/rss+xml; charset=utf-8"
	</Files>
</IfModule>
