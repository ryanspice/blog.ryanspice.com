VITE_MSAL_CLIENT_ID="your-client-id"
VITE_MSAL_TENANT_ID="common"
# Build flavor: "ryan" for blog.ryanspice.com, "canopy" for blog.canopydigital.ca.
PUBLIC_SITE_ID="ryan"
PUBLIC_SITE_URL="https://blog.ryanspice.com"
# Optional: override the owner account hash used by the browser-only owner gate.
# Keep this as a SHA-256 hash of the normalized owner email, not the raw address.
# VITE_OWNER_EMAIL_SHA256="sha256-of-normalized-owner-email"
# Optional: private server/PHP action owner hash for metadata writes.
# BLOG_OWNER_EMAIL_SHA256="sha256-of-normalized-owner-email"
# Optional: pin the callback URI. If omitted, the app uses the current origin at runtime.
# VITE_MSAL_REDIRECT_URI="http://127.0.0.1:5173/auth/callback"
