{
  "name": "blog.ryanspice.com",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SvelteKit blog project for Ryan Spice's technical articles, staged inside the AI Wiki and deployed as a PHP-static build for shared hosting.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:host": "vite --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build": "svelte-kit sync && vite build",
    "build:blog": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/Build-BlogStatic.ps1 -Clean -SiteId ryan",
    "build:blog:ryan": "pnpm run build:blog",
    "build:blog:canopy": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/Build-BlogStatic.ps1 -Clean -SiteId canopy -PublicSiteUrl https://blog.canopydigital.ca",
    "preview": "vite preview --host 127.0.0.1",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:mobile": "pnpm run test:unit && pnpm run test:e2e --project=mobile",
    "audit:files": "node ./scripts/audit-files.mjs",
    "audit:seo": "node ./scripts/audit-prerender-output.mjs",
    "verify:seo": "pnpm run build:blog && pnpm run audit:seo",
    "verify:seo:canopy": "pnpm run build:blog:canopy && pnpm run audit:seo",
    "verify:production": "pnpm run audit:files && pnpm run check && pnpm run test:unit && pnpm run build:blog && pnpm run audit:seo",
    "verify:production:full": "pnpm run verify:production && pnpm run test:e2e && pnpm run deploy:test",
    "setup:runtime": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/Repair-PnpmExternalization.ps1 -Apply -InstallDeps",
    "deploy:plan": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/Deploy-BlogStatic.ps1",
    "deploy:parallel": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/Deploy-BlogStatic.ps1 -Build -Apply",
    "deploy:activate": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/Deploy-BlogStatic.ps1 -Apply -Activate",
    "deploy:canopy:plan": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/Deploy-BlogStatic.ps1 -ConfigPath deploy.canopy.config.json",
    "deploy:canopy:parallel": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/Deploy-BlogStatic.ps1 -ConfigPath deploy.canopy.config.json -Build -Apply",
    "deploy:canopy:activate": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/Deploy-BlogStatic.ps1 -ConfigPath deploy.canopy.config.json -Apply -Activate",
    "publish:parallel": "pnpm run deploy:parallel",
    "deploy:test": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/Test-BlogDeployConnection.ps1"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.11.0",
    "mermaid": "^11.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "2.49.1",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@types/node": "^24.0.0",
    "vitest": "^3.0.5",
    "rehype-pretty-code": "^0.14.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.0.0",
    "svelte": "5.45.6",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vite": "7.2.6"
  },
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@9.0.3"
}
